<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
  E2E 矩阵操作者实例验证流程：含 opType=99 矩阵操作者的 BPMN。
  节点：开始 -> 创建(nodeType=0,opType=17) -> 矩阵审批(nodeType=1,opType=99) -> 归档(nodeType=3)。
  矩阵操作者：matrixId=2110186695577083905(E2E矩阵测试)，结果维度 owner，
  条件维度 dept，单行数据 {"dept":"20000000003","owner":"3"}。
  本图用 wfField="-1"(指定部门) 固定 objId="20000000003" 命中该行 -> 解析出办理人 user 3。
  ============================================================================
-->
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:flowable="http://flowable.org/bpmn"
             xmlns:wf="http://www.springblade.org/workflow"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             targetNamespace="http://www.springblade.org/workflow"
             xsi:schemaLocation="http://www.omg.org/spec/BPMN/20100524/MODEL http://www.omg.org/spec/BPMN/20100524/DI/BPMN20.xsd">

  <process id="matrix_e2e_approval" name="矩阵操作者E2E验证" isExecutable="true">

    <startEvent id="StartEvent_1" name="开始" flowable:initiator="initiator"/>
    <sequenceFlow id="Flow_1" name="提交" sourceRef="StartEvent_1" targetRef="Task_Create"/>

    <userTask id="Task_Create" name="申请填单" flowable:assignee="${initiator}" flowable:formKey="applyForm">
      <documentation>创建节点：发起时由程序立即 complete，token 流入矩阵审批节点。</documentation>
      <extensionElements>
        <wf:node nodeType="0" signOrder="0" allowReject="1" autoApprove="0">
          <wf:operator opType="17" objId="" signOrder="0" bhxj="0"/>
        </wf:node>
      </extensionElements>
    </userTask>
    <sequenceFlow id="Flow_2" name="提交" sourceRef="Task_Create" targetRef="Task_Matrix"/>

    <userTask id="Task_Matrix" name="矩阵审批">
      <documentation>矩阵操作者(opType=99)：经 byMatrix -> matchUsers 解析出办理人。
        条件 dept 由 wfField=-1 固定提供 20000000003，命中 E2E矩阵测试 单行 -> owner=3。</documentation>
      <extensionElements>
        <wf:node nodeType="1" signOrder="0" allowReject="1" autoApprove="0">
          <wf:operator opType="99" objId="2110223059932708866" signOrder="0" bhxj="0"
                       matrixJson='{"matrixId":"2110223059932708866","valueField":"owner","conditions":[{"condField":"div","wfField":"-13"}]}'/>
        </wf:node>
      </extensionElements>
    </userTask>
    <sequenceFlow id="Flow_3" name="通过" sourceRef="Task_Matrix" targetRef="EndEvent_1"/>

    <endEvent id="EndEvent_1" name="归档">
      <extensionElements><wf:node nodeType="3"/></extensionElements>
    </endEvent>

  </process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane bpmnElement="matrix_e2e_approval" id="BPMNPlane_1">
      <bpmndi:BPMNShape bpmnElement="StartEvent_1" id="StartEvent_1_di">
        <omgdc:Bounds x="120" y="160" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_Create" id="Task_Create_di">
        <omgdc:Bounds x="190" y="135" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="Task_Matrix" id="Task_Matrix_di">
        <omgdc:Bounds x="360" y="135" width="120" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape bpmnElement="EndEvent_1" id="EndEvent_1_di">
        <omgdc:Bounds x="560" y="155" width="30" height="30"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge bpmnElement="Flow_1" id="Flow_1_di">
        <omgdi:waypoint x="150" y="175"/><omgdi:waypoint x="190" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_2" id="Flow_2_di">
        <omgdi:waypoint x="310" y="175"/><omgdi:waypoint x="360" y="175"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge bpmnElement="Flow_3" id="Flow_3_di">
        <omgdi:waypoint x="480" y="175"/><omgdi:waypoint x="560" y="175"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</definitions>
