<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springblade</groupId>
        <artifactId>blade-service</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>blade-workflow</artifactId>
    <packaging>jar</packaging>
    <description>SpringBlade 审批流程微服务</description>

    <dependencies>
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-common</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-core-boot</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-core-launch</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-starter-tenant</artifactId>
        </dependency>
        <!-- 引入 dynamic-datasource + MyBatis（动态数据源主库 url 由 Nacos blade.yaml 提供） -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-starter-mybatis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-workflow-api</artifactId>
        </dependency>
        <!-- 反向读取表单侧数据（布局/字段/业务数据），用于组装审批态渲染包 GET /form/render -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-formmode-api</artifactId>
        </dependency>
        <!-- 反向查询用户中心：把节点操作者的「部门/角色/岗位/所有人」解析成真实办理人（生成待办） -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-user-api</artifactId>
        </dependency>
        <!-- 反向查询组织层级：解析矩阵 -13「创建人分部」条件（部门 → 所属分部） -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-system-api</artifactId>
        </dependency>
        <!-- 流程消息：待办产生/流程办结时经 INoticeClient 给相关人发通知（写入统一消息中心） -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-message-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- ============ Flowable 流程引擎（Apache-2.0，自行集成，非 BladeX 商业封装 blade-starter-flowable） ============ -->
        <!-- 说明：本项目为 Spring Boot 4.x / Java 21，Flowable 7 官方基线为 Boot 3.x / JDK 17。
             因此此处【不使用】flowable-spring-boot-starter（其自动配置在 Boot 4 下大概率失效），
             改为在 org.springblade.workflow.config.FlowableConfig 中显式装配引擎，
             仅依赖 flowable-engine + flowable-spring 两个核心库，规避自动配置兼容性问题。
             flowable.version 见根 pom <properties>。 -->
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-engine</artifactId>
            <version>${flowable.version}</version>
        </dependency>
        <dependency>
            <groupId>org.flowable</groupId>
            <artifactId>flowable-spring</artifactId>
            <version>${flowable.version}</version>
        </dependency>

        <!-- 公文版式/签章厂商实现（可选库模块）：optional，未部署时 blade-workflow 停留 L1；
             部署后其 @ConditionalOnProperty bean 被本服务组件扫描（包在 org.springblade.workflow 下） -->
        <dependency>
            <groupId>org.springblade</groupId>
            <artifactId>blade-workflow-odoc-layout</artifactId>
            <version>${revision}</version>
            <optional>true</optional>
        </dependency>

        <!-- ============ Apache POI（Apache-2.0）：公文套红合成引擎 ============ -->
        <!-- 用于 docx 书签字段替换 + 正文插入，产出套红版 docx。
             选型说明：方案原定 docx4j，但本沙箱离线不可解析；POI 5.4.1 已在本地仓库，
             能力等价（bookmark/CT 级 XML 操作），且零外部进程。合成逻辑收敛在
             org.springblade.workflow.odoc.compose 接口后，便于日后平替。 -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.4.1</version>
        </dependency>

        <!-- ============ iText 5.5.13（AGPL）：内置版式渲染器（L1 规则引擎落地） ============ -->
        <!-- 离线环境无 OFD/CA 厂商 SDK，故提供「内置 PDF 渲染器」：POI 读取套红 docx →
             iText 按 GB/T 9704 规则（A4 版心/页边距/红头红字/红色分隔线/仿宋正文/页码）渲染 PDF，
             并注入公文元数据到 PDF Info 字典。OFD/CA 仍走 IOdocFormatConvertor / IOdocSealService
             的厂商 SPI（OfdVendorConvertor / CaSealService 占位），按客户采购切换。
             注：iText 5 为 AGPL 协议，生产商用需购买商业许可或替换为 Apache PDFBox（本沙箱 PDFBox 离线缺失）。 -->
        <dependency>
            <groupId>com.itextpdf</groupId>
            <artifactId>itextpdf</artifactId>
            <version>5.5.13</version>
        </dependency>

        <!-- 仅测试用：内存库 + Spring 测试基座（版本由 spring-boot BOM 管理） -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <!-- Boot 4.1 的 repackage 按 @SpringBootApplication 注解探测启动类，
                 识别不了 SpringBlade 的组合注解 @BladeCloudApplication（9 个服务都用该注解），
                 故显式声明 mainClass，否则报 "Unable to find main class"。 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>org.springblade.workflow.WorkflowApplication</mainClass>
                    <finalName>${project.name}</finalName>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
