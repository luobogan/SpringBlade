<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.springblade.system.mapper.DeptMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="deptResultMap" type="org.springblade.system.entity.Dept">
        <id column="id" property="id"/>
        <result column="parent_id" property="parentId"/>
        <result column="ancestors" property="ancestors"/>
        <result column="dept_name" property="deptName"/>
        <result column="full_name" property="fullName"/>
        <result column="sort" property="sort"/>
        <result column="remark" property="remark"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <!-- 部门树映射：必须与 DeptMapper#tree 的返回类型 DeptVO 一致。
         早期误用 TreeNode，导致 MyBatis 造出 TreeNode 实例，
         泛型擦除后在 DeptServiceImpl#treeScope 的 for (DeptVO node : all) 处抛 ClassCastException -->
    <resultMap id="deptVOResultMap" type="org.springblade.system.vo.DeptVO">
        <id column="id" property="id"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="parent_id" property="parentId"/>
        <result column="ancestors" property="ancestors"/>
        <result column="dept_name" property="deptName"/>
        <result column="dept_code" property="deptCode"/>
        <result column="subcompany_id" property="subcompanyId"/>
        <result column="full_name" property="fullName"/>
        <result column="dept_type" property="deptType"/>
        <result column="sort" property="sort"/>
        <result column="canceled" property="canceled"/>
        <result column="manager_user_id" property="managerUserId"/>
        <result column="out_key" property="outKey"/>
        <result column="sync_uuid" property="syncUuid"/>
        <result column="pinyin" property="pinyin"/>
        <result column="limit_users" property="limitUsers"/>
        <result column="dept_level" property="deptLevel"/>
        <result column="remark" property="remark"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="baseColumnList">
        select
        id, parent_id, ancestors, dept_name, full_name, sort, remark, is_deleted
    </sql>

    <select id="selectDeptPage" resultMap="deptResultMap">
        select * from blade_dept where is_deleted = 0
    </select>

    <select id="tree" resultMap="deptVOResultMap">
        select
        id, tenant_id, parent_id, ancestors, dept_name, dept_code, subcompany_id, full_name,
        dept_type, sort, canceled, manager_user_id, out_key, sync_uuid, pinyin, limit_users,
        dept_level, remark, is_deleted
        from blade_dept where is_deleted = 0 and canceled = 0
        <if test="_parameter!=null">
            and tenant_id = #{_parameter}
        </if>
        order by sort asc, id asc
    </select>

    <select id="getDeptNames" resultType="java.lang.String">
        SELECT
        dept_name
        FROM
        blade_dept
        WHERE
        <choose>
            <when test="array != null and array.length > 0">
                id IN
                <foreach collection="array" item="ids" index="index" open="(" close=")" separator=",">
                    #{ids}
                </foreach>
            </when>
            <otherwise>
                1 = 0
            </otherwise>
        </choose>
        and is_deleted = 0
    </select>

</mapper>
